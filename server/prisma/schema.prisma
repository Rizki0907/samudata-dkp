model MasterData {
  id         Int      @id @default(autoincrement())
  category   String
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([category, value])
}

model BudidayaTahunan {
  id               Int        @id @default(autoincrement())
  tahun            Int
  kabupaten_kota   String
  modul_id         String
  data             Json
  status           DataStatus @default(PENDING)
  alasan_penolakan String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  @@unique([tahun, kabupaten_kota, modul_id])
  @@index([status, tahun, kabupaten_kota])
}

model Mangrove {
  id                   Int      @id @default(autoincrement())
  tahun                Int
  kabupaten_kota       String   @db.VarChar(100)
  luas_eksisting_ha    Float    @default(0)
  spesies              String
  persentase_kondisi   Float    @default(0)
  kondisi              String   @db.VarChar(50)
  luas_rehabilitasi_ha Float    @default(0)
  status               String   @default("PENDING") @db.VarChar(20)
  alasan_penolakan     String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@map("mangrove")
}

model lamun {
  id                   Int      @id @default(autoincrement())
  tahun                Int
  kabupaten_kota       String   @db.VarChar(100)
  luas_eksisting_ha    Float    @default(0)
  persentase_tutupan   Float    @default(0)
  kondisi              String   @db.VarChar(50)
  luas_rehabilitasi_ha Float    @default(0)
  status               String   @default("PENDING") @db.VarChar(20)
  alasan_penolakan     String?
  created_at           DateTime @default(now())
  updated_at           DateTime
}

model terumbu_karang {
  id                   Int      @id @default(autoincrement())
  tahun                Int
  kabupaten_kota       String   @db.VarChar(100)
  luas_eksisting_ha    Float    @default(0)
  persentase_tutupan   Float    @default(0)
  kondisi              String   @db.VarChar(50)
  luas_rehabilitasi_ha Float    @default(0)
  status               String   @default("PENDING") @db.VarChar(20)
  alasan_penolakan     String?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())
}

enum SumberDataPT {
  PELABUHAN
  PUD
  KAB_KOTA
}

enum DataStatus {
  PENDING
  APPROVED
  REJECTED
  VERIFIED
}
