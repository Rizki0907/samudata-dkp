model MasterData {
  id         Int      @id @default(autoincrement())
  category   String
  value      String
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([category, value])
}

model BudidayaTahunan {
  id               Int        @id @default(autoincrement())
  tahun            Int
  kabupaten_kota   String
  modul_id         String
  data             Json
  status           DataStatus @default(PENDING)
  alasan_penolakan String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  @@unique([tahun, kabupaten_kota, modul_id])
  @@index([status, tahun, kabupaten_kota])
}

model Mangrove {
  id                   Int      @id @default(autoincrement())
  tahun                Int
  kabupaten_kota       String   @db.VarChar(100)
  luas_eksisting_ha    Float    @default(0)
  spesies              String
  persentase_kondisi   Float    @default(0)
  kondisi              String   @db.VarChar(50)
  luas_sangat_padat    Float    @default(0)
  luas_sedang          Float    @default(0)
  luas_jarang          Float    @default(0)
  luas_rehabilitasi_ha Float    @default(0)
  status               String   @default("PENDING") @db.VarChar(20)
  alasan_penolakan     String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@map("mangrove")
}

model lamun {
  id                   Int      @id @default(autoincrement())
  tahun                Int
  kabupaten_kota       String   @db.VarChar(100)
  luas_eksisting_ha    Float    @default(0)
  persentase_tutupan   Float    @default(0)
  persentase_kondisi   Float    @default(0)
  kondisi              String   @db.VarChar(50)
  luas_kaya            Float    @default(0)
  luas_kurang_kaya     Float    @default(0)
  luas_miskin          Float    @default(0)
  luas_rehabilitasi_ha Float    @default(0)
  status               String   @default("PENDING") @db.VarChar(20)
  alasan_penolakan     String?
  created_at           DateTime @default(now())
  updated_at           DateTime
}

model terumbu_karang {
  id                   Int      @id @default(autoincrement())
  tahun                Int
  kabupaten_kota       String   @db.VarChar(100)
  luas_eksisting_ha    Float    @default(0)
  persentase_tutupan   Float    @default(0)
  persentase_kondisi   Float    @default(0)
  kondisi              String   @db.VarChar(50)
  luas_sangat_baik     Float    @default(0)
  luas_baik            Float    @default(0)
  luas_sedang          Float    @default(0)
  luas_rusak           Float    @default(0)
  luas_rehabilitasi_ha Float    @default(0)
  status               String   @default("PENDING") @db.VarChar(20)
  alasan_penolakan     String?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())
}

enum SumberDataPT {
  PELABUHAN
  PUD
  KAB_KOTA
}

enum DataStatus {
  PENDING
  APPROVED
  REJECTED
  VERIFIED
}

model TangkapTahunan {
  id              String   @id @default(uuid())
  tahun           String
  sumber_data     String   // PELABUHAN, PUD, KAB_KOTA
  pelabuhan       String?
  kabupaten_kota  String?
  jenis_perairan  String?
  status          DataStatus @default(PENDING) 
  alasan_penolakan String?

  rtp             Json
  nelayan         Json
  kapal           Json
  alat_tangkap    Json
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}
